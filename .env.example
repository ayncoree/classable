# Managed values are injected by the WebDev runtime; do not place secrets in browser bundles.
DATABASE_URL=<managed MySQL DSN supplied by WebDev>
MANUS_API_URL=<managed server-side service API base>
MANUS_API_KEY=<managed server-side service API key>
MANUS_PROJECT_ID=<managed OAuth project ID>
MANUS_OAUTH_PORTAL_URL=<managed OAuth portal URL>
MANUS_OAUTH_API_URL=<managed OAuth API URL>
MANUS_JWT_SECRET=<managed application-session signing key>

# Optional independent providers. Leave unset until a provider is configured server-side.
TRANSLATION_API_URL=
TRANSLATION_API_KEY=
